+ assert.equal(storageWrites, 0); assert.ok(methods.every(method => method === 'GET')); assert.equal(states[3], false);
+ assert.equal(timeouts[0], 45000); if (fetches === 2) assert.equal(timeouts[1], 30000);
+ return {message: states[2], bodyReads, verifications, GETs: fetches};
+}
+test('all four exact originals verify with or without Content-Length, without PUT or fence changes', async () => {
+ for (const asset of format.BUILD_ASSETS) for (const length of [undefined, asset.bytes]) {
+  const result = await inspect({asset, length}); assert.equal(result.message, success); assert.equal(result.bodyReads, 1); assert.equal(result.verifications, 1); assert.equal(result.GETs, 2);
+ }
+});
+test('an explicit wrong or malformed declared length still fails closed before body read', async () => {
+ for (const length of [0, format.BUILD_ASSETS[0].bytes + 1, '', 'abc']) {
+  const result = await inspect({length}); assert.match(result.message, /public-headers: DECLARED_LENGTH_MISMATCH/); assert.equal(result.bodyReads, 0); assert.equal(result.verifications, 0);
