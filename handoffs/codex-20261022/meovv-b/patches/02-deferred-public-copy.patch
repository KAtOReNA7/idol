+++ b/scripts/build-deferred-public.mjs
@@ -0,0 +1,84 @@
+// Same official build entry, with the public copy moved after compiler exit.
+// No pruning, filters, transforms, symlinks, dependency edits or helper changes.
+import fs from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {spawn} from 'node:child_process';
+import {constants as osConstants} from 'node:os';
+import {fileURLToPath} from 'node:url';
+const root=path.resolve(fileURLToPath(new URL('..',import.meta.url)));
+const digest=bytes=>createHash('sha256').update(bytes).digest('hex');
+function stat(file){try{return fs.lstatSync(file);}catch(error){if(error.code==='ENOENT')return null;throw error;}}
+function directory(file){const s=stat(file);if(!s?.isDirectory()||s.isSymbolicLink())throw new Error('Expected physical directory: '+file);}
+function ancestors(base,relative){
+ directory(base);let current=base;
+ for(const part of relative.split('/').slice(0,-1)){current=path.join(current,part);const s=stat(current);if(s&&(!s.isDirectory()||s.isSymbolicLink()))throw new Error('Non-directory/symlink ancestor: '+current);}
+}
+function fileHash(file){
+ const s=fs.lstatSync(file);if(!s.isFile()||s.isSymbolicLink())throw new Error('Expected regular file: '+file);
+ const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW),hash=createHash('sha256'),buffer=Buffer.allocUnsafe(256*1024);let total=0;
+ try{let n;while((n=fs.readSync(fd,buffer,0,buffer.length,null))>0){hash.update(buffer.subarray(0,n));total+=n;}}finally{fs.closeSync(fd);}
+ if(total!==s.size)throw new Error('File length changed while reading: '+file);
+ return {bytes:total,sha256:hash.digest('hex')};
+}
+export function snapshotPublic(project){
+ const base=path.join(project,'public');directory(base);const directories=[],files=[];
+ function walk(relative){
+  const dir=path.join(base,relative);directory(dir);directories.push(relative);
+  for(const name of fs.readdirSync(dir).sort()){
+   const rel=relative?relative+'/'+name:name,full=path.join(base,rel),s=fs.lstatSync(full);
+   if(s.isSymbolicLink())throw new Error('Public symlink rejected: '+rel);
+   if(s.isDirectory())walk(rel);else if(s.isFile())files.push({path:rel,...fileHash(full)});else throw new Error('Public special file rejected: '+rel);
+  }
+ }
+ walk('');files.sort((a,b)=>a.path<b.path?-1:a.path>b.path?1:0);directories.sort();return {directories,files};
+}
+function sameSnapshot(actual,expected){if(JSON.stringify(actual)!==JSON.stringify(expected))throw new Error('Complete public path/bytes/SHA inventory changed');}
+export function copyAllPublic(project,expected){
+ const source=path.join(project,'public'),client=path.join(project,'dist/client');
+ directory(project);directory(path.join(project,'dist'));directory(client);directory(path.join(project,'dist/server'));ancestors(client,'.vite/manifest.json');
+ if(!stat(path.join(project,'dist/server/index.js'))?.isFile()||!stat(path.join(client,'.vite/manifest.json'))?.isFile())throw new Error('Missing compiled server/client manifests');
+ const current=snapshotPublic(project);sameSnapshot(current,expected);
+ // Preflight ALL collisions before the first copy. Never overwrite generated
+ // .assetsignore, _headers, manifests, bundles, or any other existing file.
+ for(const dir of current.directories){if(!dir)continue;ancestors(client,dir);const s=stat(path.join(client,dir));if(s&&(!s.isDirectory()||s.isSymbolicLink()))throw new Error('Public directory conflicts with generated output: '+dir);}
+ for(const row of current.files){ancestors(client,row.path);if(stat(path.join(client,row.path)))throw new Error('Public file conflicts with generated output: '+row.path);}
+ for(const dir of current.directories)if(dir)fs.mkdirSync(path.join(client,dir),{recursive:true});
+ for(const row of current.files){
+  ancestors(source,row.path);ancestors(client,row.path);
+  const from=path.join(source,row.path),to=path.join(client,row.path);
+  if(!fs.lstatSync(from).isFile()||fs.lstatSync(from).isSymbolicLink())throw new Error('Public file type changed: '+row.path);
+  fs.copyFileSync(from,to,fs.constants.COPYFILE_EXCL);
+  const actual=fileHash(to);
+  if(fs.lstatSync(to).nlink!==1||actual.bytes!==row.bytes||actual.sha256!==row.sha256)throw new Error('Copied byte/SHA mismatch: '+row.path);
+ }
+ sameSnapshot(snapshotPublic(project),expected);
+ const receipt={format:'complete-deferred-public-copy.v1',phase:'after-framework-child-successful-exit',files:current.files.length,bytes:current.files.reduce((n,row)=>n+row.bytes,0),sourceAndDestinationSha256Verified:true,publicInventorySha256:digest(JSON.stringify(current)),inventory:current};
+ const runtime=path.join(project,'.sites-runtime');if(!stat(runtime))fs.mkdirSync(runtime);directory(runtime);
+ const target=path.join(runtime,'deferred-public-copy.json');const existing=stat(target);if(existing&&(!existing.isFile()||existing.isSymbolicLink()||existing.nlink!==1))throw new Error('Unsafe receipt target');
+ const temporary=target+'.'+process.pid+'.tmp';fs.writeFileSync(temporary,JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});fs.renameSync(temporary,target);
+ return receipt;
+}
+function child(script,args,environment,input){
+ return new Promise((resolve,reject)=>{
+  const processChild=spawn(process.execPath,[script,...args],{cwd:root,env:environment,stdio:[input===undefined?'inherit':'pipe','inherit','inherit']});
+  processChild.once('error',reject);processChild.once('close',(code,signal)=>{
+   if(code===0)resolve();else reject(Object.assign(new Error('Build phase failed: '+(signal||code)),{exitCode:signal?128+(osConstants.signals[signal]||1):code||1}));
+  });
+  if(input!==undefined){processChild.stdin.on('error',()=>{});processChild.stdin.end(input);}
+ });
+}
+async function main(){
+ const args=process.argv.slice(2);
+ if(args.length===1&&args[0]==='--copy-public'){
+  const receipt=copyAllPublic(root,JSON.parse(fs.readFileSync(0,'utf8')));
+  console.log(`Complete public copy verified: ${receipt.files} files, ${receipt.bytes} bytes, inventory ${receipt.publicInventorySha256}`);return;
+ }
+ if(args.length)throw new Error('No build flags accepted; copy mode is internal to the tracked wrapper.');
+ const expected=snapshotPublic(root);
+ await child(path.join(root,'scripts/run-framework.mjs'),['build'],{...process.env,SITES_DEFER_PUBLIC_COPY:'1'});
+ // The compiler process (including its V8 heap/native threads) has exited.
+ // A NEW small process performs the complete original-byte copy, not a filter.
+ await child(fileURLToPath(import.meta.url),['--copy-public'],process.env,JSON.stringify(expected));
+}
+if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url))main().catch(error=>{console.error(error.message);process.exitCode=error.exitCode||1;});
