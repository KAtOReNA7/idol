+  const html=renderToStaticMarkup(React.createElement(SequencePreview,{catalog,sequence,currentId:'recWork0',onNext:()=>{},nextDisabled:true}));
+  assert.match(html,/class="lb-sequence-next" type="button" disabled=""/);
+});
