+ assert.equal(f.read('dist/client/_next/static/chunk.js').toString(),'compiled-js');assert.equal(f.read('dist/client/_headers').toString(),'generated-security-headers');assert.equal(f.read('dist/client/.assetsignore').toString(),'generated-ignore');
+ const receipt=JSON.parse(f.read('.sites-runtime/deferred-public-copy.json'));assert.equal(receipt.files,3);assert.equal(receipt.bytes,37);assert.equal(receipt.sourceAndDestinationSha256Verified,true);assert.equal(receipt.publicInventorySha256,hash(JSON.stringify(receipt.inventory)));
+ for(const row of receipt.inventory.files){assert.equal(hash(f.read('public/'+row.path)),row.sha256);assert.equal(hash(f.read('dist/client/'+row.path)),row.sha256);}
+});
+test('compiler failure stops before copying and preserves exact exit code',t=>{const f=fixture(t,'process.exitCode=9;'),result=f.run();assert.equal(result.status,9);assert.equal(f.exists('dist/client/a.txt'),false);assert.equal(f.exists('.sites-runtime/deferred-public-copy.json'),false);});
+test('compiler SIGKILL propagates 137 without copying',t=>{const f=fixture(t,"process.kill(process.pid,'SIGKILL');"),result=f.run();assert.equal(result.status,137);assert.equal(f.exists('dist/client/a.txt'),false);assert.equal(f.exists('.sites-runtime/deferred-public-copy.json'),false);});
+test('source content changed during compiler is rejected before copying',t=>{const f=fixture(t,"put('public/a.txt','changed');"),result=f.run();assert.notEqual(result.status,0);assert.match(result.stderr,/inventory changed/);assert.equal(f.exists('dist/client/.hidden'),false);});
+test('added source path during compiler is rejected before copying',t=>{const f=fixture(t,"put('public/new.txt','new');"),result=f.run();assert.notEqual(result.status,0);assert.match(result.stderr,/inventory changed/);assert.equal(f.exists('dist/client/.hidden'),false);});
+test('all generated-file collisions preflight before any public writes',t=>{const f=fixture(t);f.put('public/_headers','must not overwrite');const result=f.run();assert.notEqual(result.status,0);assert.match(result.stderr,/conflicts/);assert.equal(f.read('dist/client/_headers').toString(),'generated-security-headers');assert.equal(f.exists('dist/client/.hidden'),false);assert.equal(f.exists('dist/client/a.txt'),false);});
+test('source symlink stops before compiler even when target is readable',t=>{const f=fixture(t);fs.symlinkSync('a.txt',path.join(f.root,'public/link'));const result=f.run();assert.notEqual(result.status,0);assert.match(result.stderr,/symlink/);assert.equal(f.exists('dist'),false);});
+test('output symlink ancestor cannot escape generated client',t=>{const f=fixture(t,"fs.mkdirSync('outside');fs.symlinkSync('../../outside','dist/client/nested');"),result=f.run();assert.notEqual(result.status,0);assert.match(result.stderr,/symlink|conflict/);assert.equal(f.exists('outside/image.bin'),false);assert.equal(f.exists('dist/client/.hidden'),false);});
