+const original = asset => new Uint8Array(fs.readFileSync(path.join(root, 'public', asset.sourceUrl)));
+async function inspect(options = {}) {
+ const asset = options.asset ?? format.BUILD_ASSETS[0], states = [], methods = [], timeouts = [];
+ let stateIndex = 0, bodyReads = 0, verifications = 0, fetches = 0, storageWrites = 0, resolveComplete;
+ const complete = new Promise(resolve => { resolveComplete = resolve; });
+ const jsx = (type, props) => ({type, props});
+ const react = {
+  useState(value) { const i = stateIndex++; states[i] = value; return [value, next => { states[i] = next; if (i === 1 && next === false) resolveComplete(); }]; },
+  useRef(value) { return {current: value}; },
+  useEffect(effect) { effect(); },
+ };
