+ const presentation=moduleAt('lib/idol/image-presentation.ts');const map=mapping(active);
+ for(const a of manifest.entries){const url=map(a.memberId,a.sourceUrl);assert.equal(presentation.imageAttemptSource(url,1),url);assert.equal(presentation.imageAttemptSource(url,10),url);}
+});
