+const mapping=config=>moduleAt('lib/idol/candidate/meovv-build-asset-portrait.ts',{'../build-asset-cutover.json':config}).meovvBuildAssetPortrait;
+const active={...cutover,enabled:true,verifiedDeploymentVersion:186,ownerReadbackEvidenceSha256:'a'.repeat(64),anonymousAccessEvidenceSha256:'b'.repeat(64)}; // Mock only, never written to candidate configuration.
+test('local B configuration is bound to live evidence; disabled/incomplete configurations preserve originals',()=>{
+ assert.equal(cutover.enabled,true);const configs=[{...active,enabled:false},{...active,verifiedDeploymentVersion:null},{...active,ownerReadbackEvidenceSha256:null},{...active,anonymousAccessEvidenceSha256:null}];
+ for(const config of configs)for(const a of manifest.entries)assert.equal(mapping(config)(a.memberId,a.sourceUrl),a.sourceUrl);
