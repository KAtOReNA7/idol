+body:has(.genblue-bluecut){background:#f3f5f7}
+.genblue-bluecut{--gb-blue:#1746aa;--gb-paper:#f3f5f7;--gb-ink:#142242;--gb-muted:#52617a;--gb-line:#c8d2e1;background:var(--gb-paper);color:var(--gb-ink);font-family:GenblueText,'Noto Sans SC',sans-serif;font-size:14px;line-height:1.55;max-width:1440px;min-height:100vh;margin-inline:auto;display:grid;grid-template-columns:128px minmax(0,1fr);isolation:isolate}
+.genblue-bluecut *{box-sizing:border-box;min-width:0}
+.genblue-bluecut :is(h1,h2,h3,p,figure,ol){margin:0}
+.genblue-bluecut :is(h1,h2,h3){font-weight:700;line-height:1.25;letter-spacing:normal}
+.genblue-bluecut :is(a,button){color:inherit;font:inherit;text-decoration:none;touch-action:manipulation}
+.genblue-bluecut button{cursor:pointer;border-radius:0}
+.genblue-bluecut :is(a,button,input):focus-visible{outline:3px solid var(--gb-blue);outline-offset:4px}
+.genblue-bluecut a:hover{text-decoration:underline;text-underline-offset:4px}
+.genblue-bluecut img{display:block;width:100%;height:auto;object-fit:contain}
+.genblue-bluecut a,.genblue-bluecut h1,.genblue-bluecut h2,.genblue-bluecut h3{overflow-wrap:anywhere}
+.gb-main{padding:48px;outline:none;min-width:0;width:100%;margin:0;max-width:none}
+.gb-navigation{background:var(--gb-blue);color:#fff;padding:32px 16px;display:flex;flex-direction:column;gap:32px;align-self:stretch}
+.genblue-bluecut .gb-brand{font-family:GenblueDisplay,sans-serif;font-weight:900;font-size:28px;line-height:.96;letter-spacing:-.03em;display:flex;flex-direction:column;color:#fff}
+.gb-navigation nav{display:grid;gap:4px}
+.gb-navigation nav a{min-height:44px;display:flex;align-items:center;padding:11px 8px;font-weight:700}
+.gb-navigation nav a[aria-current='page']{background:#fff;color:var(--gb-blue)}
+.gb-navigation :is(a,button):focus-visible{outline-color:#fff;outline-offset:2px}
+.gb-skip{position:fixed;top:8px;left:8px;z-index:10;background:#fff;padding:12px;transform:translateY(-200%)}
+.gb-skip:focus{transform:none}
+.genblue-bluecut .gb-button{display:flex;align-items:center;min-height:48px;width:280px;max-width:100%;padding:12px 20px;border:1px solid var(--gb-blue);background:var(--gb-blue);color:#fff;font-weight:700;line-height:1.25;text-align:left;border-radius:0}
+.genblue-bluecut .gb-button.gb-quiet{background:#fff;color:var(--gb-blue)}
+.genblue-bluecut .gb-button.is-disabled{background:#dfe6f1;border-color:var(--gb-line);color:var(--gb-muted);cursor:not-allowed;text-decoration:none}
+.gb-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:32px;align-items:start}
+.gb-hero-type{display:grid;gap:24px;align-content:start}
+.genblue-bluecut .gb-hero h1{font:900 132px/.96 GenblueDisplay,sans-serif;letter-spacing:-.03em;color:var(--gb-blue)}
+.gb-hero h2{font-size:30px}
+.gb-hero p{color:var(--gb-muted)}
+.gb-hero>img{aspect-ratio:4/5;max-width:560px}
+.gb-section{display:grid;gap:24px;margin-top:64px}
+.gb-section>h2{font-size:48px}
+.gb-roster{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
+.genblue-bluecut .gb-member-card{display:grid;gap:12px;align-content:start}
+.gb-member-card>img{aspect-ratio:900/506;max-width:900px}
+.gb-member-names{display:grid;grid-template-columns:58fr 42fr;gap:16px;border-bottom:3px solid var(--gb-blue);padding-bottom:12px;align-items:start}
+.gb-member-names h3{font-size:30px}
+.gb-member-names span{font:900 26px/.96 GenblueDisplay,sans-serif;letter-spacing:-.03em;color:var(--gb-blue)}
+.gb-member-card>p{font-size:12px;color:var(--gb-muted)}
+.gb-release-focus{display:grid;grid-template-columns:360px minmax(0,1fr);gap:32px;align-items:start}
