+    assert.deepEqual(result.stageRevisit.watchedUnrated, []);
+    assert.deepEqual(input.works.map((item) => ({
+      id: item.id, score: item.score, stageScore: item.stageScore, groupIds: [...item.groupIds],
+    })), snapshot);
+  }
