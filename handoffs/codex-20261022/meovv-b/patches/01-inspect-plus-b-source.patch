+  const get=html=>[...html.matchAll(/<span class="mf-roster-photo">[\s\S]*?<img[^>]*src="([^"]+)"/g)].map(x=>x[1]);
+  assert.deepEqual(get(h),get(b));assert.equal(get(h).length,5);assert.ok(get(h).every(x=>x.endsWith('-roster.webp')));
+ }
+ const sooin='/artists/meovv?section=members&member=rec28ldbniBa8G';assert.ok(actualSsr(active,s,sooin).includes('/artist/meovv/sooin-mnet-profile.jpg'));assert.equal(JSON.stringify(s),before);
+});
+for(const entry of manifest)test(`${entry.id}: actual detail click opens exact lightbox src; failures and manual retry never fall back`,()=>{
+ const s=scene(),before=JSON.stringify(s),h=harness(active,{initial:'/artists/meovv?section=members&member='+entry.memberId,scenario:s});h.render();
+ assert.equal(profileImage(h).props.src,expected(entry));const originalImage=profileImage(h);originalImage.props.onError();h.render();
+ assert.equal(profileImage(h),undefined);assert.equal(errorNodes(profile(h)).length,1);assertNoOldOrRoster(h,entry);
+ // Detail error does not disable its explicit zoom action or select a substitute source.
+ zoom(h).props.onClick();h.render();assert.equal(largeImage(h).props.src,expected(entry));assert.equal(largeImage(h).props.loading,'eager');
+ const lightImage=largeImage(h);lightImage.props.onError();h.render();assert.equal(largeImage(h),undefined);assert.equal(errorNodes(lightbox(h)).length,1);assertNoOldOrRoster(h,entry);
+ let retry=h.find(n=>n.props?.className==='photo-lightbox-retry');assert.ok(retry);assert.equal(retry.props.disabled,false);retry.props.onClick();h.render();
+ const afterRetry=largeImage(h);assert.ok(afterRetry);assert.equal(afterRetry.props.src,expected(entry));assert.notEqual(afterRetry.dom,lightImage.dom);assertNoOldOrRoster(h,entry);
+ // Stale event on the detached generation cannot overwrite the newly loading generation.
+ lightImage.props.onLoad();h.render();assert.equal(largeImage(h).props.src,expected(entry));
+ afterRetry.props.onError();h.render();retry=h.find(n=>n.props?.className==='photo-lightbox-retry');assert.equal(retry.props.disabled,true);h.advance(800);retry=h.find(n=>n.props?.className==='photo-lightbox-retry');assert.equal(retry.props.disabled,false);retry.props.onClick();h.render();assert.equal(largeImage(h).props.src,expected(entry));
+ h.find(n=>n.props?.className==='photo-lightbox-close').props.onClick();h.render();assert.equal(lightbox(h),undefined);
+ const pageRetry=h.find(n=>n.type==='button'&&n.props.className==='ri-retry');assert.ok(pageRetry);pageRetry.props.onClick();h.render();assert.equal(profileImage(h).props.src,expected(entry));assert.notEqual(profileImage(h).dom,originalImage.dom);
+ assert.deepEqual(h.requests,[]);assert.equal(JSON.stringify(s),before);h.unmount();
+});
+test('actual component dormant gate and exact-pair mismatch preserve their original sources',()=>{
+ for(const entry of manifest){let s=scene();let h=harness(dormant,{initial:'/artists/meovv?section=members&member='+entry.memberId,scenario:s});h.render();assert.equal(profileImage(h).props.src,entry.sourceUrl);h.unmount();
+  s=scene();s.content.portraits[entry.memberId].image='/synthetic/other-exact-source.jpg';h=harness(active,{initial:'/artists/meovv?section=members&member='+entry.memberId,scenario:s});h.render();assert.equal(profileImage(h).props.src,'/synthetic/other-exact-source.jpg');h.unmount();
+  s=scene();const wrong='recSyntheticWrongMember';s.catalog.members.find(m=>m.id===entry.memberId).id=wrong;s.content.portraits[wrong]=s.content.portraits[entry.memberId];delete s.content.portraits[entry.memberId];h=harness(active,{initial:'/artists/meovv?section=members&member='+wrong,scenario:s});h.render();assert.equal(profileImage(h).props.src,entry.sourceUrl);h.unmount();
+ }
+});
+test('actual roster navigation maintains five WEBPs and returns to same roster',()=>{
+ const h=harness(active);h.render();const before=rosterSources(h);assert.equal(before.length,5);assert.ok(before.every(x=>x.endsWith('-roster.webp')));
+ const entry=manifest[0];h.find(n=>n.props?.['data-artist-member-trigger']===entry.memberId).props.onClick();h.render();assert.equal(profileImage(h).props.src,expected(entry));
+ h.find(n=>n.type==='button'&&n.props.className==='mf-button mf-back').props.onClick();h.render();assert.deepEqual(rosterSources(h),before);assert.deepEqual(h.requests,[]);h.unmount();
