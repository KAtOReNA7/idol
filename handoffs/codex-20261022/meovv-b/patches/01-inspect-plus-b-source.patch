+test('missing/corrupt bodies, evidence edits, disabled switch and incomplete compiled pins are zero-write',()=>{
+ const mutations=[f=>f.put('readback/'+manifest.entries[0].id+'.jpg','not the response'),f=>fs.unlinkSync(path.join(f.readbackDir,manifest.entries[0].id+'.jpg')),f=>f.put('docs/build-assets/meovv-four-anonymous-access.json','{"anonymousBodyVerified":true}'),f=>{const name='lib/idol/build-asset-cutover.json',config=JSON.parse(fs.readFileSync(path.join(f.dir,name)));config.enabled=false;const bytes=Buffer.from(JSON.stringify(config));f.put(name,bytes);f.guards.sourceGuards[name]=pin(bytes);f.saveGuard();},f=>{f.guards.compiled.carriers={};f.saveGuard();},f=>{f.guards.compiled.dynamicPathCarriers=[];f.saveGuard();},f=>f.put('dist/server/meovv-compiled-fixture.js','different compiled bytes')];
