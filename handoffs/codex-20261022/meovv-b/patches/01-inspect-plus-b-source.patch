+ const h=harness(active,{index:true});h.render();const src='/artist/meovv/group-official.jpg';assert.equal(images(h).length,1);assert.equal(images(h)[0].props.src,src);
+ images(h)[0].props.onError();h.render();assert.equal(images(h).length,0);assert.equal(errorNodes(h.tree).length,1);assert.equal(h.all(n=>n.props?.className==='candidate-index-gallery').length,0);
