+ const run=()=>spawnSync(process.execPath,[path.join(root,'scripts/build-deferred-public.mjs')],{cwd:root,encoding:'utf8',timeout:10000,env:{...process.env,SITES_DEFER_PUBLIC_COPY:'0'}});
+ return {root,put,run,read:name=>fs.readFileSync(path.join(root,name)),exists:name=>fs.existsSync(path.join(root,name))};
+}
+test('separate compiler and copier complete every original byte, hidden file and empty directory',t=>{
