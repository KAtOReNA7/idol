+// pending until a complete build receives independent consumer/pin review.
+import fs from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const FIXED_MANIFEST_SHA = '2262fad9a601459126b789ec68b5297fb5be64426045a7b38eb3ec8017237feb';
+const SOURCE_DIRS = ['app','components','lib','data','hooks','db','vendor','public'];
+const TEXT = /\.(?:[cm]?js|jsx|[cm]?ts|tsx|json|css|html|svg|mdx|map)$/;
+const DYNAMIC = /\/artist\/meovv\/|meovv-artist|meovvRosterPortrait|mnet-profile|build-assets|meovv-four-oct22/;
+const exactGuardFiles = ['app/api/build-assets/route.ts','app/api/manage/build-assets/route.ts','app/artists/meovv/page.tsx','app/manage/build-assets/client.tsx','app/manage/build-assets/page.tsx','app/page.tsx','components/candidate-index-card.tsx','components/candidate/meovv-design.tsx','components/candidate/meovv-figma-design.css','components/photo-lightbox.tsx','components/reliable-image.tsx','data/candidate-index-visuals.json','data/meovv-artist.json','data/meovv-figma-asset-manifest.json','lib/idol/build-asset-cutover.json','lib/idol/build-asset-format.ts','lib/idol/build-asset-host.ts','lib/idol/build-asset-manifest.json','lib/idol/build-asset-service.ts','lib/idol/candidate/meovv-build-asset-portrait.ts','lib/idol/candidate/meovv-figma-assets.ts','lib/idol/candidate/meovv-roster-portrait.ts','lib/idol/candidate/portrait.ts','lib/idol/image-lightbox-session.ts','lib/idol/image-presentation.ts'].sort();
+const evidenceNames = ['meovv-four-owner-readback-original.json','meovv-four-owner-readback.json','meovv-four-anonymous-access.json'];
+function equal(a,b,message) { if (JSON.stringify(a) !== JSON.stringify(b)) throw new Error(message); }
+function safe(root,relative) {
+ if (!relative || path.isAbsolute(relative) || relative.split(/[\\/]/).some(p=>p==='..'||p==='.'||p==='')) throw new Error('Unsafe relative path');
+ let cursor=root;
+ for (const part of relative.split('/')) {
+  cursor=path.join(cursor,part);
+  if (fs.existsSync(cursor) || fs.lstatSync(path.dirname(cursor)).isSymbolicLink()) {
+   if (fs.lstatSync(cursor).isSymbolicLink()) throw new Error('Symlink rejected: '+relative);
+  }
+ }
+ return cursor;
+}
+function regular(root,relative,expected,{singleLink=false}={}) {
+ if (arguments.length>=3 && (!expected || !Number.isSafeInteger(expected.bytes) || expected.bytes<0 || typeof expected.sha256!=='string' || !/^[a-f0-9]{64}$/.test(expected.sha256))) throw new Error('Invalid required byte/SHA pin: '+relative);
+ const full=safe(root,relative), st=fs.lstatSync(full);
+ if (!st.isFile() || (singleLink&&st.nlink!==1)) throw new Error('Not an independent regular file: '+relative);
+ if (expected && st.size!==expected.bytes) throw new Error('Byte length changed: '+relative);
+ const bytes=fs.readFileSync(full);
+ if (expected && hash(bytes)!==expected.sha256) throw new Error('SHA changed: '+relative);
+ return {bytes,identity:{dev:st.dev,ino:st.ino,size:st.size,nlink:st.nlink}};
+}
+function files(dir) {
+ if (!fs.existsSync(dir)) return [];
+ if (fs.lstatSync(dir).isSymbolicLink()) throw new Error('Symlink rejected: '+dir);
+ return fs.readdirSync(dir,{withFileTypes:true}).flatMap(item=>{
+  const full=path.join(dir,item.name);
+  if(item.isSymbolicLink())throw new Error('Symlink rejected: '+full);
+  if(item.isDirectory())return files(full);
+  if(!item.isFile())throw new Error('Special file rejected: '+full);
+  return [full];
+ });
+}
+function inventory(root,roots,manifest) {
+ const result={dynamic:[],original:[]};
+ for(const file of roots.flatMap(dir=>files(path.join(root,dir)))) {
+  if(!TEXT.test(file))continue;
+  const text=fs.readFileSync(file,'utf8'),name=path.relative(root,file);
+  if(DYNAMIC.test(text))result.dynamic.push(name);
+  if(manifest.entries.some(a=>text.includes(a.sourceUrl)))result.original.push(name);
+ }
+ result.dynamic.sort();result.original.sort();return result;
+}
+function evidence(root,guards,config,manifest,readbackDir) {
+ const values={};
+ for(const name of evidenceNames)values[name]=JSON.parse(regular(root,'docs/build-assets/'+name,guards.evidenceGuards[name]).bytes);
+ const owner=values[evidenceNames[1]],anon=values[evidenceNames[2]],original=values[evidenceNames[0]];
+ equal(Object.keys(guards.evidenceGuards).sort(),[...evidenceNames].sort(),'Evidence guard set changed');
+ if(config.ownerReadbackEvidenceSha256!==guards.evidenceGuards[evidenceNames[1]].sha256 || config.anonymousAccessEvidenceSha256!==guards.evidenceGuards[evidenceNames[2]].sha256)throw new Error('Cutover evidence binding changed');
+ if(owner.format!=='meovv-four-owner-readback.v1'||owner.kind!=='owner-browser-public-get-downloaded-body'||owner.mock!==false||owner.deploymentVersion!==186||owner.sourceCommit!=='f0391481cccd85a4eb53cbe9bf63cdd77d30e350'||owner.anonymousBodyVerified!==false||owner.sourceReportSha256!==guards.evidenceGuards[evidenceNames[0]].sha256)throw new Error('Owner evidence identity changed');
+ if(anon.format!=='meovv-four-anonymous-access.v1'||anon.kind!=='user-confirmed-incognito-visibility'||anon.mock!==false||anon.deploymentVersion!==186||anon.anonymousBodyDownloaded!==false||anon.anonymousBytesShaOrHeadersMeasured!==false||anon.requestedMessageId!=='Sentinel_4048e8209e188191b4b32d222db3f770'||anon.replyMessageId!=='Sentinel_a773ccb2b3e481918f0c7bd533e8c288'||anon.replyToMessageId!==anon.requestedMessageId||anon.replyText!=='可以查看')throw new Error('Anonymous access provenance changed');
+ equal(anon.publicUrls,manifest.entries.map(a=>`/api/build-assets?id=${a.id}&version=${a.sha256}`),'Anonymous access scope changed');
+ if(original.anonymousVerified!==false||original.cutover!==false||original.entries?.length!==4||owner.entries?.length!==4)throw new Error('Original readback report changed');
+ if(readbackDir){readbackDir=path.resolve(readbackDir);if(fs.lstatSync(readbackDir).isSymbolicLink())throw new Error('Readback directory symlink rejected');}
+ for(const asset of manifest.entries){
+  const matches=owner.entries.filter(r=>r.id===asset.id),old=original.entries.filter(r=>r.id===asset.id);
+  if(matches.length!==1||old.length!==1)throw new Error('Readback entry identity changed');
+  const row=matches[0];
+  for(const key of ['sha256','bytes','mime','width','height'])if(row[key]!==asset[key])throw new Error('Readback metadata mismatch');
+  if(row.bodyFile!==asset.id+'.jpg'||row.publicUrl!==`/api/build-assets?id=${asset.id}&version=${asset.sha256}`||row.putCount!==1||row.putServerReadback!=='verified'||row.ownerBrowserDownloadedBody!=='verified'||old[0].verified!==true||old[0].sha256!==asset.sha256||old[0].bytes!==asset.bytes)throw new Error('Incomplete owner verification');
+  equal(old[0].dimensions,[asset.width,asset.height],'Owner geometry report changed');
+  if(readbackDir)regular(readbackDir,row.bodyFile,asset);
+ }
+ return {ownerBodyBytesVerified:!!readbackDir,anonymousAccessKind:anon.kind,anonymousBodyVerified:false};
+}
+export function auditMeovvCutover(root,{readbackDir}={}) {
+ root=path.resolve(root);
+ if(fs.lstatSync(root).isSymbolicLink())throw new Error('Project root symlink rejected');
+ const manifestBytes=regular(root,'lib/idol/build-asset-manifest.json').bytes;
+ if(hash(manifestBytes)!==FIXED_MANIFEST_SHA)throw new Error('Fixed four-image manifest changed');
+ const manifest=JSON.parse(manifestBytes),guards=JSON.parse(regular(root,'scripts/meovv-build-asset-cutover-guards.json').bytes);
+ if(guards.format!=='meovv-four-build-cutover-guards.v2'||guards.manifestSha256!==FIXED_MANIFEST_SHA||manifest.entries.length!==4)throw new Error('Guard identity changed');
+ equal(Object.keys(guards.sourceGuards).sort(),exactGuardFiles,'Exact consumer guard set changed');
+ for(const name of exactGuardFiles)regular(root,name,guards.sourceGuards[name]);
+ const config=JSON.parse(regular(root,'lib/idol/build-asset-cutover.json').bytes);
+ if(config.enabled!==true||config.cohort!=='meovv-four-oct22'||config.verifiedDeploymentVersion!==186)throw new Error('Active consumer switch required before pruning');
+ const sourceInventory=inventory(root,SOURCE_DIRS,manifest);
+ equal(sourceInventory.dynamic,guards.dynamicPathCarriers,'Dynamic consumer inventory changed');
+ equal(sourceInventory.original,guards.originalPathCarriers,'Original-path consumer inventory changed');
+ for(const name of sourceInventory.dynamic)if(!Object.hasOwn(guards.sourceGuards,name))throw new Error('Unpinned source carrier: '+name);
+ const visual=JSON.parse(regular(root,'data/candidate-index-visuals.json').bytes)['rec28ldfRTiC6k'];
+ if(visual.hero.image!=='/artist/meovv/group-official.jpg')throw new Error('Index hero branch changed');
+ const verifiedEvidence=evidence(root,guards,config,manifest,readbackDir),blockers=[];
+ if(!readbackDir)blockers.push('Saved owner-browser response bodies must be supplied with --readback-dir.');
+ const distRoot=safe(root,'dist');
+ if(!fs.existsSync(distRoot))blockers.push('A complete independent build is required; no dist exists.');
+ const candidates=manifest.entries.map(asset=>{
+  regular(root,'public'+asset.sourceUrl,asset);
+  const build='dist/client'+asset.sourceUrl;
+  let identity=null;
+  if(fs.existsSync(distRoot))identity=regular(root,build,asset,{singleLink:true}).identity;
+  return {id:asset.id,memberId:asset.memberId,source:'public'+asset.sourceUrl,build,bytes:asset.bytes,sha256:asset.sha256,identity};
+ });
+ const compiled=guards.compiled;
+ if(compiled?.status!=='independently-reviewed'||!compiled.carriers||Object.keys(compiled.carriers).length===0)blockers.push('Exact compiled carrier pins are pending a complete build and independent review.');
+ else {
+  if(!fs.existsSync(distRoot))throw new Error('Reviewed compiled pins without a complete build');
+  const actual=inventory(root,['dist'],manifest);
+  equal(actual.dynamic,compiled.dynamicPathCarriers,'Compiled dynamic inventory changed');
+  equal(actual.original,compiled.originalPathCarriers,'Compiled original-path inventory changed');
+  equal(Object.keys(compiled.carriers).sort(),[...new Set([...actual.dynamic,...actual.original])].sort(),'Compiled carrier pin set changed');
+  for(const [name,pin] of Object.entries(compiled.carriers)){if(!name.startsWith('dist/'))throw new Error('Compiled pin outside dist');regular(root,name,pin);}
+ }
+ return {mode:'dry-run',cutoverEnabled:true,mayDelete:blockers.length===0,publicOriginalsRetained:true,existing194PruneRulesChanged:false,payloadBytes:6004463,estimatedFourTarBytes:6007808,candidates,evidence:verifiedEvidence,blockers,packageGate:'After pruning, the official complete gzip-expanded tar must retain >=2097152 bytes; payload estimates are not package acceptance.'};
+}
+export function pruneMeovvCutover(root,options={}) {
+ const plan=auditMeovvCutover(root,options);
+ if(!plan.mayDelete)throw new Error('Prune blocked: '+plan.blockers.join(' '));
+ // Validate every target again before the first write. No source tree, R2,
+ // native data or other build path is ever a write target. A failed preflight
+ // makes zero changes. An OS unlink failure may be partial; stop, never retry.
+ for(const item of plan.candidates){const now=regular(root,item.build,item,{singleLink:true});equal(now.identity,item.identity,'Build target changed during preflight');}
+ const removed=[];
+ try {for(const item of plan.candidates){fs.unlinkSync(safe(root,item.build));removed.push(item.build);}}
+ catch(error){throw new Error(`Local prune stopped after ${removed.length} removals. Restore all four from public into a fresh build before retry. Removed: ${removed.join(',')}`,{cause:error});}
+ return {...plan,mode:'applied',removed};
+}
+if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+ let mode='dry-run',readbackDir;const args=process.argv.slice(2);
+ for(let i=0;i<args.length;i++){
+  if(args[i]==='--dry-run'){if(mode==='apply')throw new Error('Conflicting modes');continue;}
+  if(args[i]==='--apply'){if(args.includes('--dry-run'))throw new Error('Conflicting modes');mode='apply';continue;}
+  if(args[i]==='--readback-dir'&&args[i+1]){if(readbackDir)throw new Error('Duplicate readback directory');readbackDir=path.resolve(args[++i]);continue;}
+  throw new Error('Only --dry-run/--apply and --readback-dir are supported; dist is fixed to PROJECT/dist.');
+ }
+ console.log(JSON.stringify((mode==='apply'?pruneMeovvCutover:auditMeovvCutover)(process.cwd(),{readbackDir}),null,2));
+}
