+ const localFetch = async (url, init) => {
+  assert.equal(init.method, undefined); assert.equal(init.cache, 'no-store'); assert.equal(init.credentials, 'same-origin');
+  methods.push('GET'); fetches++;
+  if (fetches === 1) {
+   assert.equal(url, format.assetUrl(asset, true)); if (options.ownerTimeout) timeout();
+   if (options.invalidJson) return new Response('invalid JSON');
+   return Response.json({id: asset.id, version: asset.sha256, state: options.state ?? 'verified', ...options.report}, {status: options.ownerStatus ?? 200});
+  }
+  assert.equal(fetches, 2); assert.equal(url, format.assetUrl(asset)); if (options.publicTimeout) timeout();
+  const headers = {'content-type': options.mime ?? 'image/jpeg'};
+  if (options.length !== undefined) headers['content-length'] = String(options.length);
+  const response = new Response(options.body ?? original(asset), {status: options.publicStatus ?? 200, headers});
+  const read = response.arrayBuffer.bind(response);
+  response.arrayBuffer = () => { bodyReads++; if (options.bodyTimeout) timeout(); return read(); };
+  return response;
+ };
