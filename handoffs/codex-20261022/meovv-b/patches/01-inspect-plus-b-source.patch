+import {assetUrl, BUILD_ASSETS} from '../build-asset-format';
+import cutover from '../build-asset-cutover.json';
+// Match only at member-detail/lightbox final display points. Roster selection
+// and candidatePortrait retain their original static source identities.
+// Evidence distinguishes owner body SHA verification from user-confirmed
+// anonymous visibility; it does not claim anonymous body/header measurement.
+export function meovvBuildAssetPortrait(memberId: string, source: string | null | undefined) {
+ if (cutover.enabled !== true || cutover.cohort !== 'meovv-four-oct22' ||
+     cutover.verifiedDeploymentVersion !== 186 ||
+     !/^[a-f0-9]{64}$/.test(String(cutover.ownerReadbackEvidenceSha256)) ||
+     !/^[a-f0-9]{64}$/.test(String(cutover.anonymousAccessEvidenceSha256))) return source;
+ const asset = BUILD_ASSETS.find(item => item.memberId === memberId && item.sourceUrl === source);
+ return asset ? assetUrl(asset) : source;
+}
