+  if (name === 'react') return react;
+  if (name === 'react/jsx-runtime') return {jsx, jsxs: jsx};
+  if (name === '@/lib/idol/build-asset-format') return {...format, verifyBuildAsset: async (...args) => { verifications++; return format.verifyBuildAsset(...args); }};
+  throw new Error('Unexpected dependency ' + name);
+ }, {
+  fetch: localFetch, AbortSignal: {timeout(ms) { timeouts.push(ms); return AbortSignal.timeout(ms); }},
+  window: {addEventListener() {}, removeEventListener() {}},
