+ for(const name of Object.keys(guards.evidenceGuards))put('docs/build-assets/'+name,fs.readFileSync(path.join(root,'docs/build-assets',name)));
+ for(const a of manifest.entries)for(const prefix of ['public','readback',...(dist?['dist/client']:[])])put(prefix+(prefix==='readback'?'/'+a.id+'.jpg':a.sourceUrl),fs.readFileSync(path.join(root,'public',a.sourceUrl)));
+ if(dist){put('dist/client/artist/meovv/sooin-mnet-profile.jpg','retained SOOIN fixture');put('dist/client/artist/meovv/narin-mnet-profile-roster.webp','retained roster fixture');put('dist/server/unrelated.js','retained unrelated fixture');}
