+ }
+});
+test('actual React SSR: active four detail src switch exactly; SOOIN and both roster pages do not change',()=>{
+ const s=scene();const before=JSON.stringify(s);
+ for(const entry of manifest){const url='/artists/meovv?section=members&member='+entry.memberId;
+  const html=actualSsr(active,s,url);
+  const photo=html.match(/<figure class="mf-person-photo">([\s\S]*?)<\/figure>/)[1];
+  assert.ok(photo.includes(expected(entry).replaceAll('&','&amp;')));assert.ok(!photo.includes(entry.sourceUrl));assert.ok(!photo.includes('-roster.webp'));assert.ok(photo.includes('aria-haspopup="dialog"'));
+ }
+ for(const url of ['/artists/meovv','/artists/meovv?section=members']){
