+});
+test('missing header cannot bypass exact actual bytes, MIME, SHA, JPEG header or geometry', async () => {
+ const asset = format.BUILD_ASSETS[0], bytes = original(asset), badHash = new Uint8Array(bytes), badHeader = new Uint8Array(bytes), badGeometry = new Uint8Array(bytes);
+ badHash[badHash.length - 20] ^= 1; badHeader[0] = 0;
